{
  "$meta": {
    "description": "NOBA visual tokens. Values are extracted from web/slides/*.jsx and web/atoms/atoms.jsx. Source of truth: the JSX components. When a JSX component changes, update this file to match, then port the change to scripts/build_deck.py. Never the other way around.",
    "units": {
      "color": "hex or rgba",
      "typography.size": "px",
      "typography.leading": "unitless line-height",
      "typography.tracking": "em",
      "spacing": "px",
      "shape": "px",
      "slide": "px at 96 DPI; convert to EMU in scripts/tokens.py"
    }
  },
  "color": {
    "neutral": {
      "paper":    "#FFFFFF",
      "ink":      "#1A1A1A",
      "dark":     "#393939",
      "card":     "#F0F0F0",
      "gray":     "#DCDCDC",
      "hairline": "#EBEBEB",
      "mid-ink":  "rgba(26,26,26,0.45)",
      "mid-inv":  "rgba(255,255,255,0.5)"
    },
    "accent": {
      "orange":   "#E05820",
      "lime":     "#CBDC3A",
      "lime-alt": "#D4D830",
      "lime-alt2":"#C8D040",
      "pink":     "#BE40BE",
      "lavender": "#9898B8",
      "blue":     "#4A7FC8"
    }
  },
  "typography": {
    "family": "'Helvetica Neue', Helvetica, Arial, sans-serif",
    "weight": { "light": 300, "regular": 400, "bold": 700 },
    "scale": {
      "hero":        { "size": 96, "weight": 300, "leading": 1.05, "tracking": -0.02  },
      "display":     { "size": 80, "weight": 300, "leading": 1.05, "tracking": -0.015 },
      "headline":    { "size": 62, "weight": 300, "leading": 1.05, "tracking": -0.015 },
      "title":       { "size": 48, "weight": 300, "leading": 1.1,  "tracking": -0.01  },
      "stat-number": { "size": 56, "weight": 400, "leading": 1.0,  "tracking": 0      },
      "lead":        { "size": 23, "weight": 400, "leading": 1.4,  "tracking": 0      },
      "body":        { "size": 17, "weight": 400, "leading": 1.62, "tracking": 0      },
      "body-sm":     { "size": 15, "weight": 400, "leading": 1.58, "tracking": 0      },
      "caption":     { "size": 13, "weight": 400, "leading": 1.55, "tracking": 0      },
      "label":       { "size": 12, "weight": 400, "leading": 1.2,  "tracking": 0.08,  "uppercase": true },
      "micro":       { "size": 11, "weight": 400, "leading": 1.2,  "tracking": 0.04   }
    }
  },
  "spacing": {
    "slide-pad-y":   60,
    "slide-pad-x":   72,
    "slide-pad":     64,
    "block-gap":     40,
    "stack-gap":     28,
    "card-gap":      24,
    "card-gap-sm":   16,
    "inline-gap":    12,
    "card-pad":      36,
    "card-pad-sm":   28,
    "dark-pad-top":  52
  },
  "shape": {
    "radius-card":    24,
    "radius-pill":    999,
    "rule":           1,
    "axis-line":      2,
    "timeline-dot":   20,
    "stat-circle":    220,
    "stat-circle-sm": 120,
    "stat-overlap":   -32,
    "stat-overlap-sm":-20
  },
  "slide": {
    "width":  1920,
    "height": 1080,
    "aspect": "16:9"
  }
}
