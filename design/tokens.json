      "title":       { "size": 48, "weight": 300, "leading": 1.1,  "tracking": -0.01  },
      "stat-number": { "size": 56, "weight": 400, "leading": 1.0,  "tracking": 0      },
      "lead":        { "size": 23, "weight": 400, "leading": 1.4,  "tracking": 0      },
      "body":        { "size": 17, "weight": 400, "leading": 1.62, "tracking": 0      },
