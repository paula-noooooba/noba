{
  "$meta": {
    "description": "NOBA visual tokens. Values are extracted from web/slides/*.jsx and web/atoms/atoms.jsx. Source of truth for design: the Figma file 'NOBA PPT Design System' (qqNtw4M8gc3zYRHwKJae7W). Tokens mirror the Figma values; JSX + python-pptx builders both read from here. When a Figma value changes, update this file, then port through to the JSX and builder.",
    "scale": {
      "figma-frame": "960x540 (design at 1:1)",
      "slide": "1920x1080 (python-pptx output, 2x)",
      "rule": "every px value in this file is AT SLIDE SCALE — i.e. 2x the Figma number. Example: Figma title is 70px → tokens has 140px."
    },
    "units": {
      "color": "hex or rgba (semi-transparent gets pre-composited on implied bg in scripts/tokens.py)",
      "typography.size": "px at slide scale; convert to Pt = px * 0.75 in scripts/tokens.py",
      "typography.leading": "unitless line-height",
      "typography.tracking": "em (or negative px for tight cover titles)",
      "spacing": "px at slide scale",
      "shape": "px at slide scale",
      "slide": "px at 96 DPI; convert to EMU in scripts/tokens.py"
    }
  },
  "color": {
    "neutral": {
      "paper":    "#FFFFFF",
      "ink":      "#1A1A1A",
      "dark":     "#393939",
      "card":     "#F0F0F0",
      "gray":     "#DCDCDC",
      "hairline": "#EBEBEB",
      "mid-ink":  "rgba(26,26,26,0.45)",
      "mid-inv":  "rgba(255,255,255,0.5)"
    },
    "accent": {
      "orange":   "#E05820",
      "lime":     "#CBDC3A",
      "lime-alt": "#D4D830",
      "lime-alt2":"#C8D040",
      "pink":     "#BE40BE",
      "lavender": "#9898B8",
      "blue":     "#4A7FC8"
    }
  },
