# Copy to .env for local dev. In production these live in Modal secrets.

# Team-wide API key. Teammates paste this into the Claude plugin on install.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOBA_API_KEY=change-me-locally

# Anthropic Messages API key — funds the brief-to-deck_spec call.
ANTHROPIC_API_KEY=sk-ant-change-me

# Where generated .pptx files are stored on disk. Modal overrides to /data.
NOBA_STORAGE_ROOT=/tmp/noba-decks

# Public URL base used in download links. Modal injects its deployed URL.
NOBA_PUBLIC_BASE=http://localhost:8000

# Optional — surfaced at GET /version for deploy traceability.
NOBA_VERSION=dev
NOBA_CORE_SHA=unpinned
